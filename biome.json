{
  "$schema": "https://biomejs.dev/schemas/2.4.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!node_modules", "!.next", "!dist", "!build"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "security": {
        "recommended": true,
        "noBlankTarget": "error",
        "noDangerouslySetInnerHtml": "error",
        "noDangerouslySetInnerHtmlWithChildren": "error",
        "noGlobalEval": "error",
        "noSecrets": "off"
      },
      "performance": {
        "recommended": true,
        "noAccumulatingSpread": "error",
        "noAwaitInLoops": "warn",
        "noBarrelFile": "off",
        "noDelete": "warn",
        "noImgElement": "warn",
        "noDynamicNamespaceImportAccess": "warn"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn"
      },
      "a11y": {
        "recommended": true
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/components/CircularCarousel.jsx",
        "src/components/CircularCarousel.css",
        "src/components/GradientASCII.jsx",
        "src/components/GradientASCII.css",
        "src/components/Lanyard.jsx",
        "src/components/Lanyard.css",
        "src/components/SplitText.tsx",
        "src/components/ui/**"
      ],
      "linter": {
        "rules": {
          "a11y": {
            "recommended": false
          },
          "correctness": {
            "useExhaustiveDependencies": "off",
            "useHookAtTopLevel": "off"
          },
          "performance": {
            "noImgElement": "off"
          },
          "suspicious": {
            "noArrayIndexKey": "off",
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off"
          },
          "complexity": {
            "useOptionalChain": "off"
          }
        }
      }
    }
  ]
}
